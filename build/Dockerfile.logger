# syntax=docker/dockerfile:1.7

########## Builder ##########
FROM golang:1.25.0-alpine3.21 AS builder
WORKDIR /app

# Module layer (cacheable)
COPY go.mod go.sum ./
# COPY go.work ./   # if you use workspaces
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# Copy ONLY what the service needs
COPY cmd/logger-service/ cmd/logger-service/
COPY internal/ internal/
COPY pkg/ pkg/
COPY api/ api/

# Build
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -o /out/logger-service ./cmd/logger-service

########## Final (pinned, non-root) ##########
FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /
COPY --from=builder /out/logger-service /usr/local/bin/logger-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/logger-service"]
