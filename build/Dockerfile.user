# syntax=docker/dockerfile:1.7

########## Builder ##########
FROM golang:1.25.0-alpine3.21 AS builder
WORKDIR /app

# 1) Mod layer (cacheable)
COPY go.mod go.sum ./
# COPY go.work ./   # if you use workspaces
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# 2) Copy ONLY sources needed
COPY cmd/user-service/ cmd/user-service/
COPY internal/          internal/
COPY pkg/               pkg/
COPY api/               api/         

# 3) Build
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -buildvcs=false -ldflags="-s -w" \
      -o /out/user-service ./cmd/user-service

########## Runtime ##########
FROM gcr.io/distroless/base-debian12:nonroot   
WORKDIR /
EXPOSE 50051
ENV USER_SERVICE_ADDR=:50051
ENV USER_SERVICE_HOST=:50051
ENV USER_SERVICE_GRPC_ADDR=:50051
COPY --from=builder /out/user-service /usr/local/bin/user-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/user-service"]
